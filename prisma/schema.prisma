// Schema do banco de dados do painel de gestão da Óticas Tanaka e Relojoaria
// Aprovado com o dono da loja antes da implementação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Cadastros: clientes, receitas e fornecedores (Painel 2.0)
// ---------------------------------------------------------------------------

model Cliente {
  id           Int          @id @default(autoincrement())
  nome         String
  /// só os números, ex.: 11960776721
  telefone     String       @default("")
  cpf          String?
  email        String?
  nascimento   DateTime?
  endereco     String?
  origem       CanalOrigem?
  observacoes  String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  receitas Receita[]
  ordens   OrdemServico[]
  vendas   Venda[]

  @@index([telefone])
  @@map("clientes")
}

/// Receita de óculos com os mesmos campos do formulário "Orçamento de óculos" do site.
model Receita {
  id           Int       @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataReceita  DateTime?
  medico       String?
  tipoLente    String?
  odEsferico   String?
  odCilindrico String?
  odEixo       String?
  odAdicao     String?
  odPrisma     String?
  odBase       String?
  oeEsferico   String?
  oeCilindrico String?
  oeEixo       String?
  oeAdicao     String?
  oePrisma     String?
  oeBase       String?
  /// distância pupilar (D.P.)
  dp           String?
  observacoes  String?
  criadoEm     DateTime  @default(now())

  @@map("receitas")
}

model Fornecedor {
  id            Int       @id @default(autoincrement())
  nome          String
  razaoSocial   String?
  /// só os números
  cnpj          String?   @unique
  telefone      String?
  email         String?
  representante String?
  observacoes   String?
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  produtos Produto[]
  notas    NotaEntrada[]

  @@map("fornecedores")
}

// ---------------------------------------------------------------------------
// Produtos e estoque (relógios, armações, lentes... numa ficha só)
// ---------------------------------------------------------------------------

enum TipoProduto {
  RELOGIO
  ARMACAO
  OCULOS_SOL
  LENTE_PRONTA
  LENTE_CONTATO
  PULSEIRA
  BATERIA
  ACESSORIO
  OUTRO
}

model Produto {
  id            Int               @id @default(autoincrement())
  /// código interno da loja (o que vai na etiqueta)
  codigo        String            @unique
  codigoBarras  String?
  /// referência do fabricante / código do produto na nota do fornecedor
  referencia    String?
  tipo          TipoProduto
  marca         String?
  descricao     String
  cor           String?
  publico       PublicoRelogio?
  mecanismo     MecanismoRelogio?
  grau          String?
  ncm           String?
  unidade       String            @default("UN")
  localizacao   String?
  fornecedorId  Int?
  fornecedor    Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  quantidade    Int               @default(0)
  estoqueMinimo Int               @default(0)
  custoUnitario Float             @default(0)
  precoVenda    Float             @default(0)
  ativo         Boolean           @default(true)
  /// veio de uma lista antiga (ex.: Le Store) e ainda não foi conferido na vitrine
  aConferir     Boolean           @default(false)
  observacoes   String?
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  vendas     Venda[]
  movimentos MovimentoEstoque[]
  precos     HistoricoPreco[]
  notaItens  NotaEntradaItem[]

  @@index([tipo, marca])
  @@map("produtos")
}

/// Nota fiscal de compra lançada pelo XML (entrada de estoque).
model NotaEntrada {
  id            Int               @id @default(autoincrement())
  /// chave de acesso (44 números) — impede lançar a mesma nota duas vezes
  chave         String?           @unique
  numero        String
  serie         String?
  dataEmissao   DateTime?
  fornecedorId  Int?
  fornecedor    Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  valorProdutos Float             @default(0)
  valorTotal    Float             @default(0)
  /// parcelas (duplicatas) em JSON: [{ numero, vencimento, valor }] — viram contas a pagar
  parcelas      String?
  observacoes   String?
  funcionarioId Int?
  funcionario   Funcionario?      @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime          @default(now())

  itens NotaEntradaItem[]

  @@map("notas_entrada")
}

model NotaEntradaItem {
  id               Int         @id @default(autoincrement())
  notaId           Int
  nota             NotaEntrada @relation(fields: [notaId], references: [id], onDelete: Cascade)
  produtoId        Int?
  produto          Produto?    @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  codigoFornecedor String
  descricao        String
  ean              String?
  ncm              String?
  quantidade       Float
  custoUnitario    Float
  valorTotal       Float
  /// false = item da nota que não entrou no estoque (brinde, expositor...)
  lancado          Boolean     @default(true)

  @@map("notas_entrada_itens")
}

enum TipoMovimento {
  CADASTRO
  ENTRADA
  SAIDA_VENDA
  ESTORNO_VENDA
  AJUSTE
  CONFERENCIA
}

/// Cada entrada/saída de estoque fica registrada (quem, quando, por quê e o saldo depois).
model MovimentoEstoque {
  id            Int           @id @default(autoincrement())
  produtoId     Int
  produto       Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo          TipoMovimento
  /// positivo entra, negativo sai
  quantidade    Int
  saldo         Int
  custoUnitario Float?
  motivo        String?
  vendaId       Int?
  funcionarioId Int?
  funcionario   Funcionario?  @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime      @default(now())

  @@index([produtoId, criadoEm])
  @@map("movimentos_estoque")
}

model HistoricoPreco {
  id            Int          @id @default(autoincrement())
  produtoId     Int
  produto       Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  custoUnitario Float
  precoVenda    Float
  origem        String?
  funcionarioId Int?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime     @default(now())

  @@index([produtoId, criadoEm])
  @@map("historico_precos")
}

enum PublicoRelogio {
  MASCULINO
  FEMININO
  INFANTIL
  UNISSEX
}

enum MecanismoRelogio {
  ANALOGICO
  AUTOMATICO
  DIGITAL
  SMART
  OUTRO
}

// ---------------------------------------------------------------------------
// Ordens de serviço
// ---------------------------------------------------------------------------

enum TipoServico {
  VISAO_SIMPLES
  MULTIFOCAL
  ALTO_PADRAO_BRASLAB
  CONSERTO_RELOGIO
  TROCA_PULSEIRA_BATERIA
  AJUSTE_ARMACAO
  OUTRO
}

enum StatusOS {
  RECEBIDO
  NO_LABORATORIO_BANCADA
  PRONTO_PARA_AVISAR
  CLIENTE_AVISADO
  ENTREGUE
}

model OrdemServico {
  id               Int         @id @default(autoincrement())
  dataEntrada      DateTime
  /// nome e telefone ficam copiados na OS (comprovante e consulta online) mesmo com o cadastro do cliente
  clienteNome      String
  clienteWhatsapp  String
  clienteId        Int?
  cliente          Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tipoServico      TipoServico
  descricao        String
  prazoPrometido   DateTime
  status           StatusOS    @default(RECEBIDO)
  valorTotal       Float
  sinalPago        Float       @default(0)
  dataEntrega      DateTime?
  observacoes      String?
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt

  pagamentos PagamentoOS[]

  @@map("ordens_servico")
}

// ---------------------------------------------------------------------------
// Vendas
// ---------------------------------------------------------------------------

enum CategoriaVenda {
  OCULOS_COMPLETO
  SO_ARMACAO
  SO_LENTE
  RELOGIO
  CONSERTO_RELOGIO
  BATERIA
  ACESSORIO
  OUTRO
}

enum CanalOrigem {
  GOOGLE_MAPS
  PASSOU_EM_FRENTE
  INDICACAO
  CLIENTE_ANTIGO
  INSTAGRAM
  SITE
  OUTRO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_MAQUININHA
  OUTRO
}

enum StatusPagamento {
  PAGO
  PENDENTE
  RECUSADO
  CANCELADO
}

model Venda {
  id              Int             @id @default(autoincrement())
  dataVenda       DateTime
  clienteNome     String?
  categoria       CategoriaVenda
  descricao       String
  quantidade      Int             @default(1)
  custoTotal      Float
  valorVendido    Float
  canalOrigem     CanalOrigem
  formaPagamento  FormaPagamento  @default(OUTRO)
  statusPagamento StatusPagamento @default(PAGO)
  mercadoPagoOrderId String?      @unique
  criadoEm        DateTime        @default(now())

  produtoId Int?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  funcionarioId Int?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])

  @@map("vendas")
}

// ---------------------------------------------------------------------------
// Caixa (abertura com troco, entradas por forma de pagamento, sangria, fechamento)
// ---------------------------------------------------------------------------

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentoCaixa {
  ABERTURA
  VENDA
  RECEBIMENTO_OS
  REFORCO
  SANGRIA
  DESPESA
  ESTORNO
}

model Caixa {
  id                   Int              @id @default(autoincrement())
  status               StatusCaixa      @default(ABERTO)
  abertoEm             DateTime         @default(now())
  fechadoEm            DateTime?
  trocoInicial         Float            @default(0)
  abertoPorId          Int?
  abertoPor            Funcionario?     @relation("CaixaAbertura", fields: [abertoPorId], references: [id], onDelete: SetNull)
  fechadoPorId         Int?
  fechadoPor           Funcionario?     @relation("CaixaFechamento", fields: [fechadoPorId], references: [id], onDelete: SetNull)
  /// aberto sozinho por uma venda/recebimento com o caixa fechado
  aberturaAutomatica   Boolean          @default(false)
  /// fechamento: quanto a pessoa contou de dinheiro na gaveta
  dinheiroContado      Float?
  /// fechamento: quanto o Painel esperava de dinheiro na gaveta (guardado para o histórico)
  dinheiroEsperado     Float?
  observacaoAbertura   String?
  observacaoFechamento String?

  movimentos MovimentoCaixa[]

  @@map("caixas")
}

model MovimentoCaixa {
  id             Int                @id @default(autoincrement())
  caixaId        Int
  caixa          Caixa              @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo           TipoMovimentoCaixa
  formaPagamento FormaPagamento
  /// positivo entra, negativo sai
  valor          Float
  descricao      String
  vendaId        Int?
  ordemServicoId Int?
  funcionarioId  Int?
  funcionario    Funcionario?       @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm       DateTime           @default(now())

  @@index([caixaId])
  @@map("movimentos_caixa")
}

/// Cada valor recebido de uma OS (sinal, parte, restante na entrega).
model PagamentoOS {
  id             Int            @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico   @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  valor          Float
  formaPagamento FormaPagamento
  descricao      String?
  funcionarioId  Int?
  funcionario    Funcionario?   @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm       DateTime       @default(now())

  @@index([ordemServicoId])
  @@map("pagamentos_os")
}

// ---------------------------------------------------------------------------
// Despesas fixas
// ---------------------------------------------------------------------------

model DespesaFixa {
  id           Int      @id @default(autoincrement())
  nome         String
  valor        Float
  ativo        Boolean  @default(true)
  observacao   String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("despesas_fixas")
}

// ---------------------------------------------------------------------------
// Configurações da loja
// ---------------------------------------------------------------------------

model Configuracao {
  id           Int      @id @default(1)
  nomeLoja     String   @default("Óticas Tanaka e Relojoaria")
  endereco     String   @default("")
  whatsapp     String   @default("")
  metaDiaria   Float    @default(0)
  metaMensal   Float    @default(0)

  atualizadoEm DateTime @updatedAt

  @@map("configuracao")
}

// ---------------------------------------------------------------------------
// Funcionários (login por PIN)
// ---------------------------------------------------------------------------

model Funcionario {
  id       Int      @id @default(autoincrement())
  nome     String
  pinHash  String
  pinSalt  String
  ativo    Boolean  @default(true)
  isAdmin  Boolean  @default(false)
  criadoEm DateTime @default(now())

  vendas           Venda[]
  movimentos       MovimentoEstoque[]
  precos           HistoricoPreco[]
  notas            NotaEntrada[]
  caixasAbertos    Caixa[]            @relation("CaixaAbertura")
  caixasFechados   Caixa[]            @relation("CaixaFechamento")
  movimentosCaixa  MovimentoCaixa[]
  pagamentosOS     PagamentoOS[]

  @@map("funcionarios")
}
