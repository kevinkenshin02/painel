// Schema do banco de dados do painel de gestão da Óticas Tanaka e Relojoaria
// Aprovado com o dono da loja antes da implementação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Cadastros: clientes, receitas e fornecedores (Painel 2.0)
// ---------------------------------------------------------------------------

model Cliente {
  id           Int          @id @default(autoincrement())
  nome         String
  /// só os números, ex.: 11960776721
  telefone     String       @default("")
  cpf          String?
  email        String?
  nascimento   DateTime?
  endereco     String?
  origem       CanalOrigem?
  observacoes  String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  receitas Receita[]
  ordens   OrdemServico[]
  vendas   Venda[]

  @@index([telefone])
  @@map("clientes")
}

/// Receita de óculos com os mesmos campos do formulário "Orçamento de óculos" do site.
model Receita {
  id           Int       @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataReceita  DateTime?
  medico       String?
  tipoLente    String?
  odEsferico   String?
  odCilindrico String?
  odEixo       String?
  odAdicao     String?
  odPrisma     String?
  odBase       String?
  oeEsferico   String?
  oeCilindrico String?
  oeEixo       String?
  oeAdicao     String?
  oePrisma     String?
  oeBase       String?
  /// distância pupilar (D.P.)
  dp           String?
  observacoes  String?
  criadoEm     DateTime  @default(now())

  @@map("receitas")
}

model Fornecedor {
  id            Int       @id @default(autoincrement())
  nome          String
  razaoSocial   String?
  /// só os números
  cnpj          String?   @unique
  telefone      String?
  email         String?
  representante String?
  observacoes   String?
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  produtos Produto[]

  @@map("fornecedores")
}

// ---------------------------------------------------------------------------
// Produtos e estoque (relógios, armações, lentes... numa ficha só)
// ---------------------------------------------------------------------------

enum TipoProduto {
  RELOGIO
  ARMACAO
  OCULOS_SOL
  LENTE_PRONTA
  LENTE_CONTATO
  PULSEIRA
  BATERIA
  ACESSORIO
  OUTRO
}

model Produto {
  id            Int               @id @default(autoincrement())
  /// código interno da loja (o que vai na etiqueta)
  codigo        String            @unique
  codigoBarras  String?
  /// referência do fabricante / código do produto na nota do fornecedor
  referencia    String?
  tipo          TipoProduto
  marca         String?
  descricao     String
  cor           String?
  publico       PublicoRelogio?
  mecanismo     MecanismoRelogio?
  grau          String?
  ncm           String?
  unidade       String            @default("UN")
  localizacao   String?
  fornecedorId  Int?
  fornecedor    Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  quantidade    Int               @default(0)
  estoqueMinimo Int               @default(0)
  custoUnitario Float             @default(0)
  precoVenda    Float             @default(0)
  ativo         Boolean           @default(true)
  observacoes   String?
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  vendas     Venda[]
  movimentos MovimentoEstoque[]
  precos     HistoricoPreco[]

  @@index([tipo, marca])
  @@map("produtos")
}

enum TipoMovimento {
  CADASTRO
  ENTRADA
  SAIDA_VENDA
  ESTORNO_VENDA
  AJUSTE
  CONFERENCIA
}

/// Cada entrada/saída de estoque fica registrada (quem, quando, por quê e o saldo depois).
model MovimentoEstoque {
  id            Int           @id @default(autoincrement())
  produtoId     Int
  produto       Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo          TipoMovimento
  /// positivo entra, negativo sai
  quantidade    Int
  saldo         Int
  custoUnitario Float?
  motivo        String?
  vendaId       Int?
  funcionarioId Int?
  funcionario   Funcionario?  @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime      @default(now())

  @@index([produtoId, criadoEm])
  @@map("movimentos_estoque")
}

model HistoricoPreco {
  id            Int          @id @default(autoincrement())
  produtoId     Int
  produto       Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  custoUnitario Float
  precoVenda    Float
  origem        String?
  funcionarioId Int?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime     @default(now())

  @@index([produtoId, criadoEm])
  @@map("historico_precos")
}

enum PublicoRelogio {
  MASCULINO
  FEMININO
  INFANTIL
  UNISSEX
}

enum MecanismoRelogio {
  ANALOGICO
  AUTOMATICO
  DIGITAL
  SMART
  OUTRO
}

// ---------------------------------------------------------------------------
// Ordens de serviço
// ---------------------------------------------------------------------------

enum TipoServico {
  VISAO_SIMPLES
  MULTIFOCAL
  ALTO_PADRAO_BRASLAB
  CONSERTO_RELOGIO
  TROCA_PULSEIRA_BATERIA
  AJUSTE_ARMACAO
  OUTRO
}

enum StatusOS {
  RECEBIDO
  NO_LABORATORIO_BANCADA
  PRONTO_PARA_AVISAR
  CLIENTE_AVISADO
  ENTREGUE
}

model OrdemServico {
  id               Int         @id @default(autoincrement())
  dataEntrada      DateTime
  /// nome e telefone ficam copiados na OS (comprovante e consulta online) mesmo com o cadastro do cliente
  clienteNome      String
  clienteWhatsapp  String
  clienteId        Int?
  cliente          Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tipoServico      TipoServico
  descricao        String
  prazoPrometido   DateTime
  status           StatusOS    @default(RECEBIDO)
  valorTotal       Float
  sinalPago        Float       @default(0)
  dataEntrega      DateTime?
  observacoes      String?
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt

  @@map("ordens_servico")
}

// ---------------------------------------------------------------------------
// Vendas
// ---------------------------------------------------------------------------

enum CategoriaVenda {
  OCULOS_COMPLETO
  SO_ARMACAO
  SO_LENTE
  RELOGIO
  CONSERTO_RELOGIO
  BATERIA
  ACESSORIO
  OUTRO
}

enum CanalOrigem {
  GOOGLE_MAPS
  PASSOU_EM_FRENTE
  INDICACAO
  CLIENTE_ANTIGO
  INSTAGRAM
  SITE
  OUTRO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_MAQUININHA
  OUTRO
}

enum StatusPagamento {
  PAGO
  PENDENTE
  RECUSADO
  CANCELADO
}

model Venda {
  id              Int             @id @default(autoincrement())
  dataVenda       DateTime
  clienteNome     String?
  categoria       CategoriaVenda
  descricao       String
  quantidade      Int             @default(1)
  custoTotal      Float
  valorVendido    Float
  canalOrigem     CanalOrigem
  formaPagamento  FormaPagamento  @default(OUTRO)
  statusPagamento StatusPagamento @default(PAGO)
  mercadoPagoOrderId String?      @unique
  criadoEm        DateTime        @default(now())

  produtoId Int?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  funcionarioId Int?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])

  @@map("vendas")
}

// ---------------------------------------------------------------------------
// Despesas fixas
// ---------------------------------------------------------------------------

model DespesaFixa {
  id           Int      @id @default(autoincrement())
  nome         String
  valor        Float
  ativo        Boolean  @default(true)
  observacao   String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("despesas_fixas")
}

// ---------------------------------------------------------------------------
// Configurações da loja
// ---------------------------------------------------------------------------

model Configuracao {
  id           Int      @id @default(1)
  nomeLoja     String   @default("Óticas Tanaka e Relojoaria")
  endereco     String   @default("")
  whatsapp     String   @default("")
  metaDiaria   Float    @default(0)
  metaMensal   Float    @default(0)

  atualizadoEm DateTime @updatedAt

  @@map("configuracao")
}

// ---------------------------------------------------------------------------
// Funcionários (login por PIN)
// ---------------------------------------------------------------------------

model Funcionario {
  id       Int      @id @default(autoincrement())
  nome     String
  pinHash  String
  pinSalt  String
  ativo    Boolean  @default(true)
  isAdmin  Boolean  @default(false)
  criadoEm DateTime @default(now())

  vendas     Venda[]
  movimentos MovimentoEstoque[]
  precos     HistoricoPreco[]

  @@map("funcionarios")
}
